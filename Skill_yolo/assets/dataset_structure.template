# YOLO 数据集标准目录结构模板

# ============================================================
# 复制以下结构到你的项目中，按需修改
# ============================================================

# 假设项目根目录为: E:/2026-3-25/ecar/yolo/
# 数据集根目录:   E:/2026-3-25/ecar/yolo/dataset/

# dataset/
# ├── images/
# │   ├── train/
# │   │   ├── Anumber_00001.jpg
# │   │   ├── Anumber_00002.jpg
# │   │   ├── black_00001.jpg
# │   │   ├── black_00002.jpg
# │   │   ├── blue_00001.jpg
# │   │   ├── blue_00002.jpg
# │   │   ├── yellow_00001.jpg
# │   │   └── yellow_00002.jpg
# │   └── val/
# │       ├── Anumber_00001.jpg
# │       ├── black_00001.jpg
# │       ├── blue_00001.jpg
# │       └── yellow_00001.jpg
# └── labels/
#     ├── train/
#     │   ├── Anumber_00001.txt
#     │   ├── black_00001.txt
#     │   ├── blue_00001.txt
#     │   └── yellow_00001.txt
#     └── val/
#         ├── Anumber_00001.txt
#         ├── black_00001.txt
#         ├── blue_00001.txt
#         └── yellow_00001.txt

# ============================================================
# PowerShell 创建目录命令
# ============================================================

# $base = "E:\2026-3-25\ecar\yolo\dataset"
# New-Item -ItemType Directory -Force -Path "$base\images\train", "$base\images\val", "$base\labels\train", "$base\labels\val"

# ============================================================
# 图片文件名前缀规范（按靶分类）
# ============================================================

# | 靶   | 颜色   | 前缀     |
# |------|--------|----------|
# | A    | 数字靶  | Anumber  |
# | B    | 黑色靶  | black   |
# | C    | 蓝色靶  | blue    |
# | D    | 黄色靶  | yellow  |

# ============================================================
# 标签文件内容格式示例
# ============================================================

# 文件名: Anumber_00001.txt
# 内容:
#   0 0.500 0.500 0.208 0.278
# 解释:
#   class_id=0 (Anumber)
#   x_center=0.500 (图片宽度 50% 处)
#   y_center=0.500 (图片高度 50% 处)
#   width=0.208   (目标占图片宽度 20.8%)
#   height=0.278  (目标占图片高度 27.8%)
